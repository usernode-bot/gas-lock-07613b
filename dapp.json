{
  "icon": {
    "image": "brand/icon.png",
    "emoji": "⛽"
  },
  "description": "Monitor real-time gas fees and token unlock risks across multiple blockchains",
  "secrets": [],
  "tests": [
    {
      "id": "gas-lock.dashboard",
      "name": "Dashboard renders with gas meter and favorites toggle",
      "path": "/",
      "expectText": "Favorites only",
      "expectSelector": "#gas-grid",
      "visual": true,
      "impact": ["public/index.html", "public/app.js", "public/logo.svg", "public/icon.svg", "public/icon-192.png", "public/icon-512.png", "public/apple-touch-icon.png", "public/site.webmanifest", "styles/tailwind-input.css", "tailwind.config.js"]
    },
    {
      "name": "Header shows the Gas & Lock logo",
      "path": "/",
      "expectSelector": "[data-app-logo]"
    },
    {
      "name": "App icon and web manifest are declared",
      "path": "/",
      "expectSelector": "link[rel=\"manifest\"]"
    },
    {
      "name": "Gas tracker shows all four chains",
      "path": "/",
      "expectText": "Ethereum"
    },
    {
      "name": "Weekly fee heatmap renders",
      "path": "/",
      "expectSelector": "#heatmap"
    },
    {
      "name": "Cost calculator renders",
      "path": "/",
      "expectText": "Cost calculator"
    },
    {
      "name": "Lock tracker shows upcoming unlocks",
      "path": "/",
      "expectText": "Celestia",
      "expectSelector": "#locks-grid"
    }
  ]
}
